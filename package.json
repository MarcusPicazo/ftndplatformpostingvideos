  "private": true,
  "description": "Publicador automatico de Reels (Instagram y Facebook) para el proyecto musical Fraternidad.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "check": "tsx src/check.ts",
    "subir-lote": "tsx src/subir-lote.ts",
