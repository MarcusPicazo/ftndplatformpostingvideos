GRAPH_VERSION=v27.0

# Solo para scripts/obtener-token.ts (token de pagina de Tezontle). FTND no los necesita.
META_APP_ID=
META_APP_SECRET=

# FTND — Instagram API with Unified Login (sin pagina de Facebook)
# Token: SUAT generado en el panel de Meta, caducidad "Nunca".
FTND_IG_TOKEN=
# Opcional: npm run check lo muestra (via /me/assigned_instagram_accounts).
FTND_IG_USER_ID=

# Tezontle — Instagram (via Facebook Login), Facebook Page, LinkedIn
TEZONTLE_IG_TOKEN=
TEZONTLE_IG_USER_ID=
TEZONTLE_FB_PAGE_TOKEN=
TEZONTLE_FB_PAGE_ID=
TEZONTLE_LINKEDIN_TOKEN=
TEZONTLE_LINKEDIN_PERSON_URN=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Solo para pruebas locales con un S3 simulado. Dejar vacío en uso real.
# R2_ENDPOINT=
